import os, sys, unittest, bpy
sys.path.insert(0, os.path.abspath('.'))
import src.rig.arm_ik as arm_ik
from src.config import PipelineConfig
from src.character.builder import build_character
from src.rig.builder import build_rig, bind_character_to_rig
from src.rig.ik import setup_leg_ik, reset_leg_ik
from src.rig.pose import reset_pose

class _RaiseBeforeSetitemDict(dict):
    def __init__(self, initial=None):
        super().__init__(initial or {})
        self.calls = []
    def __setitem__(self, key, value):
        self.calls.append(key)
        raise RuntimeError('INJECTED_BEFORE_RECEIPT_WRITE')

class _RaiseAfterSetitemDict(dict):
    def __init__(self, initial=None):
        super().__init__(initial or {})
        self.written = []
    def __setitem__(self, key, value):
        super().__setitem__(key, value)
        self.written.append((key, value))
        if key not in self:
            raise AssertionError('Receipt key missing after super().__setitem__')
        raise RuntimeError('INJECTED_AFTER_RECEIPT_WRITE')

class _RaiseBeforeAppendList(list):
    def __init__(self, initial=None):
        super().__init__(initial or [])
        self.attempted = []
    def append(self, item):
        self.attempted.append(item)
        raise RuntimeError('INJECTED_BEFORE_REGISTRY_APPEND')

class _RaiseAfterAppendList(list):
    def __init__(self, initial=None):
        super().__init__(initial or [])
        self.appended = []
    def append(self, item):
        super().append(item)
        self.appended.append(item)
        raise RuntimeError('INJECTED_AFTER_REGISTRY_APPEND')

class TestR3Tail01Group2FaultWindows(unittest.TestCase):
    def setUp(self):
        bpy.ops.wm.read_factory_settings(use_empty=True)
        arm_ik._clear_test_fault_injection_hook()
        arm_ik._clear_test_depsgraph_updater()
        arm_ik._PENDING_ARM_RIG_CLEANUPS.clear()
        arm_ik._ISOLATED_FAILED_ARMATURES.clear()
        arm_ik._MANAGED_ARMATURE_IDENTITIES.clear()
        arm_ik._ARCHIVED_FAILED_D_TOMBSTONES.clear()
        arm_ik._FAILED_A_AUDIT_RECORDS.clear()
        arm_ik._DEISOLATION_AUDIT_LOG.clear()
        arm_ik._clear_coordinator_authorization_grants()
        cfg = PipelineConfig()
        char_data = build_character(cfg)
        self.armature = build_rig(cfg)
        bind_character_to_rig(self.armature, char_data['parts'])
        setup_leg_ik(self.armature)
        reset_leg_ik(self.armature)
        reset_pose(self.armature)
        bpy.context.view_layer.update()

    def tearDown(self):
        arm_ik._clear_test_fault_injection_hook()
        arm_ik._clear_test_depsgraph_updater()
        arm_ik._PENDING_ARM_RIG_CLEANUPS.clear()
        arm_ik._ISOLATED_FAILED_ARMATURES.clear()
        arm_ik._MANAGED_ARMATURE_IDENTITIES.clear()
        arm_ik._ARCHIVED_FAILED_D_TOMBSTONES.clear()
        arm_ik._FAILED_A_AUDIT_RECORDS.clear()
        arm_ik._DEISOLATION_AUDIT_LOG.clear()
        arm_ik._clear_coordinator_authorization_grants()

    def test_A_failure_before_receipt_write(self):
        p_fore = self.armature.pose.bones['forearm.L']
        p_upper = self.armature.pose.bones['upper_arm.L']
        ext_fore = p_fore.constraints.new(type='LIMIT_ROTATION')
        ext_fore.name = 'ExtPreA'
        ext_fore_ptr = int(ext_fore.as_pointer())
        ext_other = p_upper.constraints.new(type='LIMIT_ROTATION')
        ext_other.name = 'ArmIK.L'
        ext_other_ptr = int(ext_other.as_pointer())
        bpy.context.view_layer.update()

        captured_tx = []
        inner_checked = []
        with self.assertRaises(RuntimeError) as cm:
            with arm_ik._arm_rig_transaction(self.armature) as tx:
                captured_tx.append(tx)
                trap_dict = _RaiseBeforeSetitemDict(tx._constraint_creation_receipts)
                tx._constraint_creation_receipts = trap_dict
                try:
                    arm_ik._authorized_create_constraint(p_fore, 'IK', 'ArmIK.L', active_tx=tx, arm=self.armature)
                except RuntimeError as exc:
                    self.assertIn('INJECTED_BEFORE_RECEIPT_WRITE', str(exc))
                    self.assertEqual(len(trap_dict.calls), 1)
                    self.assertEqual(len(tx._constraint_creation_receipts), 0)
                    self.assertEqual(len(tx.created_constraints), 0)
                    self.assertEqual([c.name for c in p_fore.constraints], ['ExtPreA'])
                    self.assertEqual(p_fore.constraints[0].as_pointer(), ext_fore_ptr)
                    inner_checked.append(True)
                    raise

        self.assertIn('INJECTED_BEFORE_RECEIPT_WRITE', str(cm.exception))
        self.assertEqual(inner_checked, [True])
        self.assertEqual(len(captured_tx), 1)
        tx = captured_tx[0]
        self.assertEqual(tx.state, arm_ik._ArmRigTransactionState.ROLLED_BACK)
        self.assertEqual(len(tx._constraint_creation_receipts), 0)
        self.assertEqual(len(tx.created_constraints), 0)
        self.assertEqual(len(arm_ik._ACTIVE_TRANSACTION_STACK), 0)
        self.assertEqual([c.name for c in p_fore.constraints], ['ExtPreA'])
        self.assertEqual(p_fore.constraints[0], ext_fore)
        self.assertEqual(p_fore.constraints[0].as_pointer(), ext_fore_ptr)
        self.assertEqual(p_upper.constraints['ArmIK.L'], ext_other)
        self.assertEqual(p_upper.constraints['ArmIK.L'].as_pointer(), ext_other_ptr)
        print('PASS Group 2-A')

    def test_B_failure_after_receipt_write(self):
        p_fore = self.armature.pose.bones['forearm.L']
        p_upper = self.armature.pose.bones['upper_arm.L']
        ext_fore = p_fore.constraints.new(type='LIMIT_ROTATION')
        ext_fore.name = 'ExtPreB'
        ext_fore_ptr = int(ext_fore.as_pointer())
        ext_other = p_upper.constraints.new(type='LIMIT_ROTATION')
        ext_other.name = 'ArmIK.L'
        ext_other_ptr = int(ext_other.as_pointer())
        bpy.context.view_layer.update()

        cleanup_calls = []
        orig_cleanup = arm_ik._cleanup_failed_constraint_creation
        def spy_cleanup(pbone, con, expected_ptr, pbone_ptr, before_ptrs, active_tx):
            cleanup_calls.append((expected_ptr, pbone_ptr))
            return orig_cleanup(pbone, con, expected_ptr, pbone_ptr, before_ptrs, active_tx)

        captured_tx = []
        inner_checked = []
        arm_ik._cleanup_failed_constraint_creation = spy_cleanup
        try:
            with self.assertRaises(RuntimeError) as cm:
                with arm_ik._arm_rig_transaction(self.armature) as tx:
                    captured_tx.append(tx)
                    trap_dict = _RaiseAfterSetitemDict(tx._constraint_creation_receipts)
                    tx._constraint_creation_receipts = trap_dict
                    try:
                        arm_ik._authorized_create_constraint(p_fore, 'IK', 'ArmIK.L', active_tx=tx, arm=self.armature)
                    except RuntimeError as exc:
                        self.assertIn('INJECTED_AFTER_RECEIPT_WRITE', str(exc))
                        self.assertEqual(len(trap_dict.written), 1)
                        written_ptr, written_receipt = trap_dict.written[0]
                        written_con_ref = written_receipt[0]
                        self.assertEqual(len(cleanup_calls), 1)
                        self.assertEqual(cleanup_calls[0][0], written_ptr)
                        self.assertNotIn(written_ptr, tx._constraint_creation_receipts)
                        self.assertEqual(len(tx._constraint_creation_receipts), 0)
                        self.assertEqual(len(tx.created_constraints), 0)
                        self.assertNotIn('ArmIK.L', p_fore.constraints)
                        self.assertFalse(any(int(c.as_pointer()) == written_ptr for c in p_fore.constraints))
                        self.assertNotIn(written_con_ref, list(p_fore.constraints))
                        self.assertEqual([c.name for c in p_fore.constraints], ['ExtPreB'])
                        self.assertEqual(p_upper.constraints['ArmIK.L'].as_pointer(), ext_other_ptr)
                        inner_checked.append(written_ptr)
                        raise
        finally:
            arm_ik._cleanup_failed_constraint_creation = orig_cleanup

        self.assertIn('INJECTED_AFTER_RECEIPT_WRITE', str(cm.exception))
        self.assertEqual(len(inner_checked), 1)
        tx = captured_tx[0]
        self.assertEqual(tx.state, arm_ik._ArmRigTransactionState.ROLLED_BACK)
        self.assertEqual(len(tx._constraint_creation_receipts), 0)
        self.assertEqual(len(tx.created_constraints), 0)
        self.assertEqual(p_fore.constraints['ExtPreB'], ext_fore)
        self.assertEqual(p_fore.constraints['ExtPreB'].as_pointer(), ext_fore_ptr)
        self.assertEqual(p_upper.constraints['ArmIK.L'], ext_other)
        self.assertEqual(p_upper.constraints['ArmIK.L'].as_pointer(), ext_other_ptr)
        print('PASS Group 2-B')

    def test_C_failure_before_registry_append(self):
        p_fore = self.armature.pose.bones['forearm.L']
        p_upper = self.armature.pose.bones['upper_arm.L']
        ext_fore = p_fore.constraints.new(type='LIMIT_ROTATION')
        ext_fore.name = 'ExtPreC'
        ext_fore_ptr = int(ext_fore.as_pointer())
        ext_other = p_upper.constraints.new(type='LIMIT_ROTATION')
        ext_other.name = 'ArmIK.L'
        ext_other_ptr = int(ext_other.as_pointer())
        bpy.context.view_layer.update()

        cleanup_calls = []
        orig_cleanup = arm_ik._cleanup_failed_constraint_creation
        def spy_cleanup(pbone, con, expected_ptr, pbone_ptr, before_ptrs, active_tx):
            cleanup_calls.append((expected_ptr, pbone_ptr))
            return orig_cleanup(pbone, con, expected_ptr, pbone_ptr, before_ptrs, active_tx)

        captured_tx = []
        inner_checked = []
        arm_ik._cleanup_failed_constraint_creation = spy_cleanup
        try:
            with self.assertRaises(RuntimeError) as cm:
                with arm_ik._arm_rig_transaction(self.armature) as tx:
                    captured_tx.append(tx)
                    trap_list = _RaiseBeforeAppendList(tx.created_constraints)
                    tx.created_constraints = trap_list
                    try:
                        arm_ik._authorized_create_constraint(p_fore, 'IK', 'ArmIK.L', active_tx=tx, arm=self.armature)
                    except RuntimeError as exc:
                        self.assertIn('INJECTED_BEFORE_REGISTRY_APPEND', str(exc))
                        self.assertEqual(len(trap_list.attempted), 1)
                        att = trap_list.attempted[0]
                        self.assertEqual(len(tx.created_constraints), 0)
                        self.assertEqual(len(cleanup_calls), 1)
                        self.assertEqual(cleanup_calls[0][0], att['con_ptr'])
                        self.assertEqual(len(tx._constraint_creation_receipts), 0)
                        self.assertNotIn('ArmIK.L', p_fore.constraints)
                        self.assertFalse(any(int(c.as_pointer()) == att['con_ptr'] for c in p_fore.constraints))
                        self.assertNotIn(att['con_ref'], list(p_fore.constraints))
                        self.assertEqual([c.name for c in p_fore.constraints], ['ExtPreC'])
                        self.assertEqual(p_upper.constraints['ArmIK.L'].as_pointer(), ext_other_ptr)
                        inner_checked.append(att['con_ptr'])
                        raise
        finally:
            arm_ik._cleanup_failed_constraint_creation = orig_cleanup

        self.assertIn('INJECTED_BEFORE_REGISTRY_APPEND', str(cm.exception))
        self.assertEqual(len(inner_checked), 1)
        tx = captured_tx[0]
        self.assertEqual(tx.state, arm_ik._ArmRigTransactionState.ROLLED_BACK)
        self.assertEqual(len(tx.created_constraints), 0)
        self.assertEqual(len(tx._constraint_creation_receipts), 0)
        self.assertEqual(p_fore.constraints['ExtPreC'], ext_fore)
        self.assertEqual(p_fore.constraints['ExtPreC'].as_pointer(), ext_fore_ptr)
        self.assertEqual(p_upper.constraints['ArmIK.L'], ext_other)
        self.assertEqual(p_upper.constraints['ArmIK.L'].as_pointer(), ext_other_ptr)
        print('PASS Group 2-C')

    def test_D_failure_after_registry_append(self):
        p_fore = self.armature.pose.bones['forearm.L']
        p_upper = self.armature.pose.bones['upper_arm.L']
        ext1 = p_fore.constraints.new(type='LIMIT_ROTATION')
        ext1.name = 'ExtFirstD'
        ext1.mute = True
        ext1.influence = 0.35
        ext1_ptr = int(ext1.as_pointer())

        ext2 = p_fore.constraints.new(type='LIMIT_LOCATION')
        ext2.name = 'ExtSecondD'
        ext2.mute = False
        ext2.influence = 0.75
        ext2_ptr = int(ext2.as_pointer())

        ext_other = p_upper.constraints.new(type='LIMIT_ROTATION')
        ext_other.name = 'ArmIK.L'
        ext_other_ptr = int(ext_other.as_pointer())
        bpy.context.view_layer.update()

        cleanup_calls = []
        remove_calls = []
        orig_cleanup = arm_ik._cleanup_failed_constraint_creation
        orig_remove = arm_ik._authorized_remove_constraint

        def spy_cleanup(pbone, con, expected_ptr, pbone_ptr, before_ptrs, active_tx):
            before_names = [c.name for c in pbone.constraints]
            res = orig_cleanup(pbone, con, expected_ptr, pbone_ptr, before_ptrs, active_tx)
            after_names = [c.name for c in pbone.constraints]
            cleanup_calls.append((expected_ptr, before_names, after_names))
            return res

        def spy_remove(pbone, con_record_or_ref, phase, active_tx=None):
            rec_ptr = con_record_or_ref.get('con_ptr') if isinstance(con_record_or_ref, dict) else con_record_or_ref.as_pointer()
            remove_calls.append((phase, rec_ptr))
            return orig_remove(pbone, con_record_or_ref, phase, active_tx=active_tx)

        captured_tx = []
        new_ref_box = []
        arm_ik._cleanup_failed_constraint_creation = spy_cleanup
        arm_ik._authorized_remove_constraint = spy_remove
        try:
            with self.assertRaises(RuntimeError) as cm:
                with arm_ik._arm_rig_transaction(self.armature) as tx:
                    captured_tx.append(tx)
                    trap_list = _RaiseAfterAppendList(tx.created_constraints)
                    tx.created_constraints = trap_list
                    try:
                        arm_ik._authorized_create_constraint(p_fore, 'IK', 'ArmIK.L', active_tx=tx, arm=self.armature)
                    except RuntimeError as exc:
                        self.assertIn('INJECTED_AFTER_REGISTRY_APPEND', str(exc))
                        self.assertEqual(len(trap_list.appended), 1)
                        app = trap_list.appended[0]
                        new_ref_box.append((app['con_ref'], app['con_ptr']))
                        self.assertEqual(len(cleanup_calls), 1)
                        self.assertEqual(cleanup_calls[0][1], cleanup_calls[0][2])
                        self.assertEqual([c.name for c in p_fore.constraints], ['ExtFirstD', 'ExtSecondD', 'ArmIK.L'])
                        self.assertEqual(len(remove_calls), 0)
                        raise
        finally:
            arm_ik._cleanup_failed_constraint_creation = orig_cleanup
            arm_ik._authorized_remove_constraint = orig_remove

        self.assertIn('INJECTED_AFTER_REGISTRY_APPEND', str(cm.exception))
        self.assertEqual(len(new_ref_box), 1)
        new_con_ref, new_con_ptr = new_ref_box[0]
        tx = captured_tx[0]
        self.assertEqual(tx.state, arm_ik._ArmRigTransactionState.ROLLED_BACK)
        self.assertEqual(remove_calls, [('ROLLBACK', new_con_ptr)])
        self.assertNotIn('ArmIK.L', p_fore.constraints)
        self.assertFalse(any(int(c.as_pointer()) == new_con_ptr for c in p_fore.constraints))
        self.assertNotIn(new_con_ref, list(p_fore.constraints))
        self.assertEqual([c.name for c in p_fore.constraints], ['ExtFirstD', 'ExtSecondD'])
        self.assertEqual(p_fore.constraints[0], ext1)
        self.assertEqual(p_fore.constraints[0].as_pointer(), ext1_ptr)
        self.assertEqual(p_fore.constraints[0].type, 'LIMIT_ROTATION')
        self.assertTrue(p_fore.constraints[0].mute)
        self.assertAlmostEqual(p_fore.constraints[0].influence, 0.35, places=5)
        self.assertEqual(p_fore.constraints[1], ext2)
        self.assertEqual(p_fore.constraints[1].as_pointer(), ext2_ptr)
        self.assertEqual(p_fore.constraints[1].type, 'LIMIT_LOCATION')
        self.assertFalse(p_fore.constraints[1].mute)
        self.assertAlmostEqual(p_fore.constraints[1].influence, 0.75, places=5)
        self.assertEqual(p_upper.constraints['ArmIK.L'], ext_other)
        self.assertEqual(p_upper.constraints['ArmIK.L'].as_pointer(), ext_other_ptr)
        print('PASS Group 2-D')

    def test_E1_cleanup_failure_real_authority_unproven(self):
        p_fore = self.armature.pose.bones['forearm.L']
        p_upper = self.armature.pose.bones['upper_arm.L']
