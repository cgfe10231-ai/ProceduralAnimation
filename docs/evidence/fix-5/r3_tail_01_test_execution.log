        ext_other = p_upper.constraints.new(type='LIMIT_ROTATION')
        ext_other.name = 'ArmIK.L'
        ext_other_ptr = int(ext_other.as_pointer())
        bpy.context.view_layer.update()

        captured_tx = []
        def hook(stage, ctx):
            if stage == 'character_constraint_after_creation_before_registration':
                ctx['tx']._constraint_creation_receipts = 'CORRUPTED_LEDGER_E1'
                raise RuntimeError('ORIGINAL_CREATION_FAULT_E1')

        arm_ik._set_test_fault_injection_hook(hook)
        inner_checked = []
        try:
            with self.assertRaises(RuntimeError) as cm_tx:
                with arm_ik._arm_rig_transaction(self.armature) as tx:
                    captured_tx.append(tx)
                    try:
                        arm_ik._authorized_create_constraint(p_fore, 'IK', 'ArmIK.L', active_tx=tx, arm=self.armature)
                    except RuntimeError as exc:
                        self.assertIn('CONSTRAINT_CREATION_CLEANUP_FAILED', str(exc))
                        self.assertIn('ORIGINAL_CREATION_FAULT_E1', str(exc))
