        self.assertEqual(p_upper.constraints['ArmIK.L'].as_pointer(), ext_other_ptr)
        print('PASS Group 2-F1')

    def test_F2_corrupted_receipt_and_same_name_bone_refuses_deletion(self):
        p_fore = self.armature.pose.bones['forearm.L']
        p_upper = self.armature.pose.bones['upper_arm.L']
        ext_fore = p_fore.constraints.new(type='LIMIT_ROTATION')
        ext_fore.name = 'ExtPreF2'
        ext_fore_ptr = int(ext_fore.as_pointer())
        ext_other = p_upper.constraints.new(type='LIMIT_ROTATION')
        ext_other.name = 'ArmIK.L'
        ext_other_ptr = int(ext_other.as_pointer())
        bpy.context.view_layer.update()

        captured_tx = []
        created_box = []
        layer3_rejections = []
        def hook(stage, ctx):
            if stage == 'during_rollback_execution':
                act_tx = ctx['tx']
                try:
                    arm_ik._authorized_remove_constraint(p_upper, act_tx.created_constraints[0], phase='ROLLBACK', active_tx=act_tx)
                except RuntimeError as l3e1:
                    layer3_rejections.append(str(l3e1))
                try:
                    arm_ik._authorized_remove_constraint(
                        p_upper,
                        {'con_ptr': ext_other_ptr, 'con_ref': ext_other, 'pbone': p_upper, 'bone_name': 'upper_arm.L', 'created_name': 'ArmIK.L'},
                        phase='ROLLBACK',
                        active_tx=act_tx,
                    )
                except RuntimeError as l3e2:
                    layer3_rejections.append(str(l3e2))

        arm_ik._set_test_fault_injection_hook(hook)
        try:
            with self.assertRaises(RuntimeError) as cm:
                with arm_ik._arm_rig_transaction(self.armature) as tx:
                    captured_tx.append(tx)
                    new_con = arm_ik._authorized_create_constraint(p_fore, 'IK', 'ArmIK.L', active_tx=tx, arm=self.armature)
                    new_ptr = int(new_con.as_pointer())
                    created_box.append((new_con, new_ptr))
                    tx._constraint_creation_receipts[new_ptr] = (
                        new_con,
                        new_ptr,
                        p_upper,
                        int(p_upper.as_pointer()),
                        tx.session_id,
                        tx.tx_id,
                        object(),
                        frozenset(),
                    )
                    raise RuntimeError('FAULT_TRIGGER_ROLLBACK_F2')
        finally:
            arm_ik._clear_test_fault_injection_hook()

        self.assertEqual(len(layer3_rejections), 2)
        new_con, new_ptr = created_box[0]
        tx = captured_tx[0]
        self.assertEqual(tx.state, arm_ik._ArmRigTransactionState.FAILED)
        self.assertNotEqual(tx.state, arm_ik._ArmRigTransactionState.ROLLED_BACK)
        self.assertIn('FAULT_TRIGGER_ROLLBACK_F2', str(cm.exception))
        self.assertIn('Rollback constraint restoration failed', str(cm.exception))
        self.assertIsNotNone(cm.exception.__cause__)
        self.assertIn('FAULT_TRIGGER_ROLLBACK_F2', str(cm.exception.__cause__))
        self.assertTrue(any(int(c.as_pointer()) == new_ptr for c in p_fore.constraints))
        self.assertEqual(p_fore.constraints['ExtPreF2'], ext_fore)
        self.assertEqual(p_fore.constraints['ExtPreF2'].as_pointer(), ext_fore_ptr)
        self.assertEqual(p_upper.constraints['ArmIK.L'], ext_other)
        self.assertEqual(p_upper.constraints['ArmIK.L'].as_pointer(), ext_other_ptr)
        print('PASS Group 2-F2')

