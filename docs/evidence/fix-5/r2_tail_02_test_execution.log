import os, sys, unittest
import bpy
PROJECT_ROOT = os.path.abspath('.')
if PROJECT_ROOT not in sys.path:
    sys.path.insert(0, PROJECT_ROOT)
from src.config import PipelineConfig
from src.character.builder import build_character
from src.rig.builder import build_rig, bind_character_to_rig
from src.rig.ik import setup_leg_ik, reset_leg_ik
from src.rig.pose import reset_pose
import src.rig.arm_ik as arm_ik

class _RaisingBeforeAppendList(list):
    def append(self, item):
        raise RuntimeError('Injected fault BEFORE registry.append')

class _RaisingAfterAppendList(list):
    def append(self, item):
        super().append(item)
        raise RuntimeError('Injected fault AFTER registry.append')

class _RaisingPopAfterAppendList(list):
    def pop(self, index=-1):
        raise RuntimeError('Injected registry.pop failure during undo')

class _RaisingBeforeSetitemDict(dict):
    def __setitem__(self, k, v):
        raise RuntimeError('Injected fault BEFORE receipt.__setitem__')

class _RaisingAfterSetitemDict(dict):
    def __setitem__(self, k, v):
        super().__setitem__(k, v)
        raise RuntimeError('Injected fault AFTER receipt.__setitem__')

class _RaisingAfterSetitemAndPopDict(dict):
    def __setitem__(self, k, v):
        super().__setitem__(k, v)
        raise RuntimeError('Injected fault AFTER receipt.__setitem__')
    def pop(self, *args, **kwargs):
        raise RuntimeError('Injected receipt.pop failure during undo')

class R2Tail02CollectionAtomicityFaultTests(unittest.TestCase):
    def setUp(self):
        bpy.ops.wm.read_factory_settings(use_empty=True)
        arm_ik._clear_test_fault_injection_hook()
        arm_ik._clear_test_depsgraph_updater()
        arm_ik._PENDING_ARM_RIG_CLEANUPS.clear()
        arm_ik._ISOLATED_FAILED_ARMATURES.clear()
        arm_ik._MANAGED_ARMATURE_IDENTITIES.clear()
        arm_ik._ARCHIVED_FAILED_D_TOMBSTONES.clear()
        arm_ik._FAILED_A_AUDIT_RECORDS.clear()
        arm_ik._DEISOLATION_AUDIT_LOG.clear()
        arm_ik._clear_coordinator_authorization_grants()
        self.cfg = PipelineConfig()
        self.char_data = build_character(self.cfg)
        self.arm = build_rig(self.cfg)
        bind_character_to_rig(self.arm, self.char_data['parts'])
        setup_leg_ik(self.arm)
        reset_leg_ik(self.arm)
        reset_pose(self.arm)
        bpy.context.view_layer.update()

    def tearDown(self):
        arm_ik._clear_test_fault_injection_hook()
        arm_ik._clear_test_depsgraph_updater()
        arm_ik._PENDING_ARM_RIG_CLEANUPS.clear()
        arm_ik._ISOLATED_FAILED_ARMATURES.clear()
        arm_ik._MANAGED_ARMATURE_IDENTITIES.clear()
        arm_ik._ARCHIVED_FAILED_D_TOMBSTONES.clear()
        arm_ik._FAILED_A_AUDIT_RECORDS.clear()
        arm_ik._DEISOLATION_AUDIT_LOG.clear()
        arm_ik._clear_coordinator_authorization_grants()

    def test_A_normal_collection_registration(self):
        scene = bpy.context.scene
        with arm_ik._arm_rig_transaction(self.arm) as tx:
            new_col = bpy.data.collections.new('TxColA_R2T02')
            new_ptr = int(new_col.as_pointer())
            self.assertEqual(len(tx.created_collections), 0)
            self.assertEqual(len(tx._collection_creation_receipts), 0)
            tx.register_created_collection(new_col, initial_parent=scene.collection)
            print('[A] AFTER_REG registry:', tx.created_collections)
            print('[A] AFTER_REG receipt_keys:', list(tx._collection_creation_receipts.keys()))
            self.assertEqual(len(tx.created_collections), 1)
            self.assertEqual(len(tx._collection_creation_receipts), 1)
            rec = tx.created_collections[0]
            rc = tx._collection_creation_receipts[new_ptr]
            self.assertEqual(rec['col_ref'], new_col)
            self.assertEqual(rec['col_ptr'], new_ptr)
            self.assertEqual(rec['created_name'], 'TxColA_R2T02')
            self.assertEqual(rec['initial_parent'], scene.collection)
            self.assertEqual(rec['initial_parent_ptr'], int(scene.collection.as_pointer()))
            self.assertEqual(len(rc), 5)
            self.assertEqual(rc[0], new_col)
            self.assertEqual(rc[1], scene.collection)
            self.assertEqual(rc[2], tx.session_id)
            self.assertEqual(rc[3], tx.tx_id)
            self.assertIs(rc[4], tx._collection_receipt_seal)
        self.assertEqual(tx.state, arm_ik._ArmRigTransactionState.COMMITTED)

    def test_B_registry_append_failure_leaves_zero_residual(self):
        scene = bpy.context.scene
        with arm_ik._arm_rig_transaction(self.arm) as tx:
            prior_col = bpy.data.collections.new('PriorCol_B')
            prior_ptr = int(prior_col.as_pointer())
            target_col = bpy.data.collections.new('TargetCol_B')
            target_ptr = int(target_col.as_pointer())
            tx.register_created_collection(prior_col, initial_parent=scene.collection)
            orig_reg = tx.created_collections
            orig_rc = tx._collection_creation_receipts
            snap_reg_id = orig_reg[0]
            snap_rc_val = orig_rc[prior_ptr]
            print('[B] BEFORE reg_len:', len(orig_reg), 'rc_keys:', list(orig_rc.keys()))

            try:
                tx.created_collections = _RaisingBeforeAppendList(orig_reg)
                with self.assertRaises(RuntimeError) as cm:
                    tx.register_created_collection(target_col, initial_parent=scene.collection)
                print('[B] CAUGHT_EXC:', cm.exception)
                self.assertIn('Injected fault BEFORE registry.append', str(cm.exception))
                self.assertEqual(len(tx.created_collections), 1)
                self.assertIs(tx.created_collections[0], snap_reg_id)
                self.assertEqual(list(tx._collection_creation_receipts.keys()), [prior_ptr])
                self.assertIs(tx._collection_creation_receipts[prior_ptr], snap_rc_val)
                self.assertNotIn(target_ptr, tx._collection_creation_receipts)
                self.assertIsNotNone(arm_ik._find_live_collection_by_identity(target_col, target_ptr))
                print('[B] AFTER_FAIL reg_len:', len(tx.created_collections), 'rc_keys:', list(tx._collection_creation_receipts.keys()))
            finally:
                tx.created_collections = orig_reg

