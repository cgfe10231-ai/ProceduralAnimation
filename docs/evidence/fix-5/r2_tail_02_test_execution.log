    def test_F_undo_failure_propagates_dual_exceptions(self):
        scene = bpy.context.scene
        with arm_ik._arm_rig_transaction(self.arm) as tx:
            col_f1 = bpy.data.collections.new('ColF1')
            col_f2 = bpy.data.collections.new('ColF2')
            orig_reg = tx.created_collections
            orig_rc = tx._collection_creation_receipts
            try:
                tx.created_collections = _RaisingPopAfterAppendList()
                tx._collection_creation_receipts = _RaisingBeforeSetitemDict()
                with self.assertRaises(RuntimeError) as cm1:
                    tx.register_created_collection(col_f1, initial_parent=scene.collection)
                msg1 = str(cm1.exception)
                print('[F1] DUAL_EXC:', msg1)
                self.assertIn('COLLECTION_REGISTRATION_ROLLBACK_FAILED', msg1)
                self.assertIn('Injected fault BEFORE receipt.__setitem__', msg1)
                self.assertIn('Injected registry.pop failure during undo', msg1)
                self.assertEqual(tx.state, arm_ik._ArmRigTransactionState.ACTIVE)
            finally:
                tx.created_collections = orig_reg
                tx._collection_creation_receipts = orig_rc

            try:
                tx._collection_creation_receipts = _RaisingAfterSetitemAndPopDict()
                with self.assertRaises(RuntimeError) as cm2:
                    tx.register_created_collection(col_f2, initial_parent=scene.collection)
                msg2 = str(cm2.exception)
                print('[F2] DUAL_EXC:', msg2)
                self.assertIn('COLLECTION_REGISTRATION_ROLLBACK_FAILED', msg2)
                self.assertIn('Injected fault AFTER receipt.__setitem__', msg2)
                self.assertIn('Injected receipt.pop failure during undo', msg2)
            finally:
                tx._collection_creation_receipts = orig_rc
                tx.created_collections.clear()

    def test_G_external_and_other_tx_resources_protected(self):
        scene = bpy.context.scene
        orig_ext_col = bpy.data.collections.new('OrigExtCol_G')
        scene.collection.children.link(orig_ext_col)
        orig_ext_ptr = int(orig_ext_col.as_pointer())
        bpy.context.view_layer.update()

        other_tx = arm_ik._ArmRigTransactionContext(self.arm, session_record=arm_ik.ensure_armature_session_identity(self.arm))
        other_col = bpy.data.collections.new('OtherTxCol_G')
        other_ptr = int(other_col.as_pointer())
        other_rec = {'col_ref': other_col, 'col_ptr': other_ptr, 'created_name': 'OtherTxCol_G', 'initial_parent': scene.collection, 'initial_parent_ptr': int(scene.collection.as_pointer())}
        other_rc = (other_col, scene.collection, other_tx.session_id, other_tx.tx_id, other_tx._collection_receipt_seal)
        other_tx.created_collections.append(other_rec)
        other_tx._collection_creation_receipts[other_ptr] = other_rc

        with self.assertRaises(RuntimeError) as cm_rb:
            with arm_ik._arm_rig_transaction(self.arm) as tx:
                target_col = bpy.data.collections.new('TxFailCol_G')
                with self.assertRaises(RuntimeError) as cm_pre:
                    tx.register_created_collection(orig_ext_col, initial_parent=scene.collection)
                self.assertIn('COLLECTION_OWNERSHIP_UNPROVEN', str(cm_pre.exception))
                self.assertEqual(len(tx.created_collections), 0)
                self.assertEqual(len(tx._collection_creation_receipts), 0)

                orig_rc = tx._collection_creation_receipts
                try:
                    tx._collection_creation_receipts = _RaisingBeforeSetitemDict(orig_rc)
                    tx.register_created_collection(target_col, initial_parent=scene.collection)
                finally:
                    tx._collection_creation_receipts = orig_rc

        print('[G] TX_ROLLBACK_EXC:', cm_rb.exception)
        self.assertIn('Injected fault BEFORE receipt.__setitem__', str(cm_rb.exception))
        self.assertEqual(tx.state, arm_ik._ArmRigTransactionState.ROLLED_BACK)
        self.assertIsNotNone(arm_ik._find_live_collection_by_identity(orig_ext_col, orig_ext_ptr))
        self.assertIn('OrigExtCol_G', scene.collection.children)
        self.assertEqual(len(other_tx.created_collections), 1)
        self.assertIs(other_tx.created_collections[0], other_rec)
        self.assertIs(other_tx._collection_creation_receipts[other_ptr], other_rc)
        self.assertIn('TxFailCol_G', bpy.data.collections)

suite = unittest.defaultTestLoader.loadTestsFromTestCase(R2Tail02CollectionAtomicityFaultTests)
